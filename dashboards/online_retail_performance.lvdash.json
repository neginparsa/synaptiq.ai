{
  "datasets": [
    {
      "name": "ds_kpis",
      "displayName": "KPIs",
      "queryLines": [
        "SELECT ROUND(net_merchandise_revenue, 2) AS net_merchandise_revenue, sale_invoices, identified_customers, ROUND(return_credit_rate * 100, 2) AS return_rate_pct FROM workspace.default.dashboard_kpis"
      ]
    },
    {
      "name": "ds_monthly",
      "displayName": "Monthly gross vs net",
      "queryLines": [
        "SELECT month, 'Gross' AS series, gross_revenue AS revenue, is_partial_period FROM workspace.default.dashboard_monthly_revenue UNION ALL SELECT month, 'Net' AS series, net_revenue AS revenue, is_partial_period FROM workspace.default.dashboard_monthly_revenue"
      ]
    },
    {
      "name": "ds_products",
      "displayName": "Top products",
      "queryLines": [
        "SELECT description, net_revenue, net_units, invoices FROM workspace.default.dashboard_top_products ORDER BY net_revenue DESC"
      ]
    },
    {
      "name": "ds_customers",
      "displayName": "Top customers",
      "queryLines": [
        "SELECT CAST(customer_id AS STRING) AS customer_id, country, net_revenue, sale_invoices FROM workspace.default.dashboard_top_customers ORDER BY net_revenue DESC"
      ]
    },
    {
      "name": "ds_geo",
      "displayName": "International markets",
      "queryLines": [
        "SELECT Country, net_revenue, invoices, identified_customers, revenue_share FROM workspace.default.dashboard_geography_ex_uk ORDER BY net_revenue DESC"
      ]
    },
    {
      "name": "ds_returns",
      "displayName": "Monthly return rate",
      "queryLines": [
        "SELECT month, ROUND(return_rate * 100, 2) AS return_rate_pct, is_partial_period FROM workspace.default.dashboard_monthly_returns ORDER BY month"
      ]
    }
  ],
  "pages": [
    {
      "name": "page1",
      "displayName": "Online Retail Performance",
      "layout": [
        {
          "widget": {
            "name": "hdr",
            "multilineTextboxSpec": {
              "lines": [
                "# Online Retail Performance\n",
                "Merchandise metrics from the EDA notebook (`trade` / `sales` / `returns`). December 2011 is a partial month \u2014 not a decline. UK is excluded from the international chart only; it remains in the KPIs."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "kpi_net",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_kpis",
                  "fields": [
                    {
                      "name": "net_merchandise_revenue",
                      "expression": "`net_merchandise_revenue`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "net_merchandise_revenue",
                  "displayName": "Net merchandise revenue"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Net merchandise revenue"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 2,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "kpi_inv",
